---
import { NAME, GITHUB, LINKEDIN, EMAIL, RESUME } from '../data/site';
---

<section class="hero">
  <div class="container">
    <p class="eyebrow">Computer Science · Columbia University</p>
    <h1>{NAME}</h1>
    <p class="intro">
      Hello, welcome to my website! I&rsquo;m a CS student at Columbia University building some cool personal and professional software projects like my closet planning app which I use every morning. Feel free to take a look around while I'm off exploring CTFs and digital design!
    </p>
    <ul class="links">
      <li><a href={GITHUB}>GitHub</a></li>
      <li><a href={LINKEDIN}>LinkedIn</a></li>
      <li><a href={RESUME}>Resume</a></li>
      <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 6.5rem) var(--space-section);
    background-image: linear-gradient(
      to bottom,
      var(--color-blush-wash),
      var(--color-bg) 70%
    );
  }

  h1 {
    margin-bottom: 0.35em;
  }

  .intro {
    font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-ink);
    max-width: 44ch;
    margin-bottom: 2rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }
</style>
