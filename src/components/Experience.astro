---
import { HEYBUDDY_URL } from '../data/site';
---

<section id="experience" class="section section--wash">
  <div class="container">
    <h2 class="section-title">Experience</h2>

    <article class="role">
      <div class="meta">
        <p class="dates">May &ndash; Aug 2026</p>
      </div>
      <div class="body">
        <h3>
          Software Engineering Intern &middot; <a href={HEYBUDDY_URL}>heybuddy</a>
        </h3>
        <p>
          I helped develop software for CSM's at heybuddy, cleaning up architecture and implementing testing workflows, creating github actions reviews for PRs, and developing new features like automatic email drafting and severity based ranking for a CSM's accounts.
        </p>
      </div>
    </article>
  </div>
</section>

<style>
  .role {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: 1rem 2.5rem;
    border-top: 1px solid var(--color-tint);
    padding-top: 1.75rem;
  }

  .dates {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    margin: 0;
    padding-top: 0.35rem;
  }

  h3 {
    font-size: 1.375rem;
    margin-bottom: 0.5em;
  }

  @media (max-width: 40rem) {
    .role {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .dates {
      padding-top: 0;
    }
  }
</style>
