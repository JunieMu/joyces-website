---
import { Image } from 'astro:assets';
import profile from '../assets/profile.jpg';
---

<section id="about" class="section section--wash">
  <div class="container">
    <h2 class="section-title">About</h2>

    <div class="layout">
      <Image class="photo" src={profile} alt="Joyce Ma" width={360} densities={[1, 2]} />

      <div class="prose">
        <p>
          When I&rsquo;m not in class or shipping side projects, I might be sketching or painting digitally, reading some epic sci-fi or fantasy novels, or hanging out with my super fluffy cat, Louis. Also am a cheesecake enthusiast.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--color-tint);
  }

  .prose p {
    font-size: 1.0625rem;
  }

  @media (max-width: 44rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }

    .photo {
      width: min(12rem, 60%);
    }
  }
</style>
